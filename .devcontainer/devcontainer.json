{
  "name": "Diyalog 360",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "containerEnv": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1", "DOTNET_NOLOGO": "1" },
  "postCreateCommand": "cd web && npm ci && cd ../api && dotnet restore",
  "postAttachCommand": "scripts/codespace.sh",
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "Diyalog 360", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-dotnettools.csharp"] }
  }
}
